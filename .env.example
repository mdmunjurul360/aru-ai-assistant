# Telegram (https://my.telegram.org/apps)
# Both TG_* and TELEGRAM_* naming conventions are supported:
TG_API_ID=
TG_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_ID=
TELEGRAM_SECRET=

# ==============================================================================
# AI Providers (Automatic failover: Groq -> Gemini -> Cloudflare -> OpenAI -> DeepSeek)
# Supports multiple API keys per provider (comma, semicolon, or newline separated).
# Singular variables (GEMINI_API_KEY) are fully supported and automatically merged.
# ==============================================================================
# OpenRouter (Primary LLM Provider — https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=openai/gpt-4o-mini

GEMINI_API_KEY=
GEMINI_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=

# Cloudflare Workers AI (https://dash.cloudflare.com → Workers & Pages → AI)
# Multi-account support: configure unlimited numbered accounts (_2, _3, ...) or comma-separated pairs.
# Primary / Account 1:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# CLOUDFLARE_API_KEYS=key1,key2

# Account 2 (Failover):
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_KEY_2=

# Account 3 (Failover):
# CLOUDFLARE_ACCOUNT_ID_3=
# CLOUDFLARE_API_KEY_3=

GROQ_MODEL=llama-3.3-70b-versatile
LLM_PRIORITY=openrouter,groq,gemini,cloudflare,deepseek
LLM_TIMEOUT=30
LLM_RETRY=2
LLM_COOLDOWN_SECONDS=300

# Your Telegram user ID (numeric). Only this user can command Aru.
BOSS_TELEGRAM_ID=

# Optional unlock code for /unlock during first setup
SECRET_CODE=

# Groq model (llama3-70b-8192 is retired; fallback chain is built-in)
GROQ_MODEL=llama-3.3-70b-versatile

# Scheduler (24h format, Asia/Dhaka or your timezone)
SCHEDULER_TIMEZONE=Asia/Dhaka
MORNING_REPORT_HOUR=8
MORNING_REPORT_MINUTE=0
NIGHT_SUMMARY_HOUR=22
NIGHT_SUMMARY_MINUTE=0
MAINTENANCE_HOUR=3
MAINTENANCE_MINUTE=0

# Research Engine (providers: duckduckgo, tavily, serper)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_MAX_RESULTS=5

# Autonomous Agent (ReAct + Tool Calling)
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=90.0

