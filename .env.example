# Telegram (https://my.telegram.org/apps)
TG_API_ID=
TG_API_HASH=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Your Telegram user ID (numeric). Only this user can command Aru.
BOSS_TELEGRAM_ID=

# Optional unlock code for /unlock during first setup
SECRET_CODE=

# Groq model (llama3-70b-8192 is retired; fallback chain is built-in)
GROQ_MODEL=llama-3.3-70b-versatile

# Scheduler (24h format, Asia/Dhaka or your timezone)
SCHEDULER_TIMEZONE=Asia/Dhaka
MORNING_REPORT_HOUR=8
MORNING_REPORT_MINUTE=0
NIGHT_SUMMARY_HOUR=22
NIGHT_SUMMARY_MINUTE=0
